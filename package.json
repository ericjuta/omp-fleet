{
	"name": "@ericjuta/omp-fleet",
	"version": "0.1.6",
	"description": "Bounded Herdr supervisor sidecar control for Oh My Pi",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ericjuta/omp-fleet.git"
	},
	"homepage": "https://github.com/ericjuta/omp-fleet#readme",
	"bugs": {
		"url": "https://github.com/ericjuta/omp-fleet/issues"
	},
	"files": [
		"index.ts",
		"src",
		"skills",
		"docs",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.3.0",
		"omp": ">=17.2.12"
	},
	"omp": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"check": "bun run biome:check && bun run typecheck && bun test",
		"typecheck": "tsc --noEmit",
		"biome:check": "biome check .",
		"biome:format": "biome format --write .",
		"format": "bun run biome:format",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@oh-my-pi/pi-coding-agent": "17.2.12",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
